# CORS Proxy Environment Variables Example
# Copy this file to .env and fill in appropriate values
# DO NOT commit the actual .env file to version control

# Database configuration
DB_HOST=turntable.proxy.rlwy.net
DB_PORT=28889
DB_USER=root
DB_PASSWORD=your-database-password-here
DB_NAME=railway

# Network configuration for IPv4 compatibility
MYSQL_TCP_PROTOCOL=4
IPV6_DISABLED=true
GODEBUG=netdns=go

# Proxy configuration
PORT=8080
BACKEND_URL=https://your-backend-service.up.railway.app

# Security
# Generate with: node generate-jwt-secret.js
JWT_SECRET=your-secure-random-generated-jwt-secret-here