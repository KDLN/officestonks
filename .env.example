# Database Configuration (Railway MySQL)
# Railway provides these automatically when you provision a MySQL database
MYSQLHOST=your-mysql-host.railway.app
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=your-mysql-password
MYSQLDATABASE=railway

# Alternative database variables (if not using Railway)
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_PORT=3306

# Authentication
JWT_SECRET=your-secret-jwt-key

# Server
PORT=8080

# Frontend configuration (add to frontend/.env)
# REACT_APP_BACKEND_URL=https://your-backend.up.railway.app
