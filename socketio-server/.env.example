# Socket.IO Server Configuration

# Port to run Socket.IO server on (Railway will set this)
PORT=3001

# CORS origin for Socket.IO connections
CORS_ORIGIN=https://beta.officestonks.com

# JWT Secret (must match your Go backend)
JWT_SECRET=your-secret-key-change-in-production

# Go Backend URL for fetching stock updates
GO_BACKEND_URL=http://localhost:8080

# For Railway deployment, these will be set automatically