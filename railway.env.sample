# Database configuration
DB_HOST=mysql.railway.internal
DB_USER=root
DB_PASSWORD=your-railway-provided-password
DB_NAME=railway
DB_PORT=3306

# Fallback database configuration
FALLBACK_DB_HOST=turntable.proxy.rlwy.net
FALLBACK_DB_PORT=28889
FALLBACK_DB_USER=root
FALLBACK_DB_PASSWORD=your-fallback-password
FALLBACK_DB_NAME=railway

# Alternative database configuration
ALT_DB_HOST=turntable.proxy.rlwy.net
ALT_DB_PORT=28889
ALT_DB_USER=root
ALT_DB_PASSWORD=your-alt-password
ALT_DB_NAME=railway

# Application configuration
PORT=8080
JWT_SECRET=your-jwt-secret-key

# Supabase configuration (optional - for Discord OAuth)
SUPABASE_PROJECT_REF=your-supabase-project-id

# Set this to the domain where your frontend is hosted
CORS_ORIGIN=https://officestonks.com