FROM golang:1.20-alpine AS builder

WORKDIR /app

# Copy go.mod and go.sum
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy the static server
COPY static-server.go ./

# Build the static server
RUN go build -o static-server static-server.go

# Create a lightweight container
FROM alpine:latest

WORKDIR /app

# Copy the binary from the builder stage
COPY --from=builder /app/static-server /app/static-server

# Expose the port
EXPOSE 8080

# Run the static server
CMD ["/app/static-server"]